# ==========================================
# 数据清洗管道 - 环境变量示例
# ==========================================
# 复制此文件为 .env 并填入你的实际配置：
#   cp .env.example .env
# ⚠️ .env 已加入 .gitignore，不会被提交

# ---------- 数据 ----------
# 原始数据路径
RAW_DATA_PATH=data/raw/
# 清洗后输出路径
CLEAN_DATA_PATH=data/clean/
# 单文件最大行数（用于分块）
CHUNK_SIZE=100000

# ---------- 处理 ----------
# 并行 worker 数（0 = 自动）
NUM_WORKERS=0
# 内存限制（MB）
MEMORY_LIMIT_MB=4096

# ---------- 质量检查 ----------
# 必填字段
REQUIRED_FIELDS=user_id,event_type,timestamp
# 缺失值阈值（超过此比例报错）
MISSING_VALUE_THRESHOLD=0.3
